# Copy to .env and enter the existing MySQL connection settings.
# Keep passwords quoted. Escape literal $ as \$ (Next.js expands $VARIABLE).
# These server-only variables must never use the NEXT_PUBLIC_ prefix.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=""
DB_NAME=jxaccount

# Optional absolute paths if MySQL is not installed under Program Files/MySQL.
# mysqldump should match the server version; mysql needs --binary-mode (5.6+).
# MYSQL_CLIENT_PATH="C:/Program Files/MySQL/MySQL Server 8.0/bin/mysql.exe"
# MYSQL_DUMP_PATH="C:/Program Files/MySQL/MySQL Server 5.5/bin/mysqldump.exe"
